PROJECT_NAME="Complaint Management System Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Auth / JWT
JWT_SECRET="change-this-in-production-super-secret-key-32chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + asyncpg)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="complaint_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/complaint_db"

# AI Module Integration
AI_SERVICE_URL="http://localhost:8001"
AI_REQUEST_TIMEOUT_SECONDS=3.0

# Assignment Logic Weights
SKILL_MATCH_WEIGHT=0.3
AVAILABILITY_WEIGHT=0.25
WORKLOAD_WEIGHT=0.25
CATEGORY_MATCH_WEIGHT=0.1
PRIORITY_WEIGHT=0.1

# Escalation Thresholds (in hours)
ESCALATION_HOURS_URGENT=2
ESCALATION_HOURS_HIGH=8
ESCALATION_HOURS_MEDIUM=24
ESCALATION_HOURS_LOW=72
